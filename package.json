{
  "name": "polishts",
  "version": "1.0.0",
  "description": "Polish TypeScript transpiler from plts to ts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/ressca/polishTS.git"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LANGUAGE_SPEC.md",
    "CHANGELOG.md",
    "examples/hello.plts",
    "examples/retry.plts",
    "examples/tasks.plts",
    "examples/react-vite/index.html",
    "examples/react-vite/package.json",
    "examples/react-vite/package-lock.json",
    "examples/react-vite/src",
    "examples/react-vite/tsconfig.json",
    "examples/react-vite/vite.config.ts"
  ],
  "bin": {
    "plts": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node --input-type=module -e \"import { chmodSync } from 'node:fs'; chmodSync('dist/cli.js', 0o755)\"",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "tsx --test test/*.test.ts",
    "package:smoke": "node scripts/package-smoke.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "prepack": "npm run build"
  }, 
  "keywords": ["polish", "typescript", "transpiler"],
  "author": "Mateusz Cichosz",
  "license": "MIT",
  "dependencies": {
    "@babel/generator": "^7.23.6",
    "@babel/parser": "^7.23.6",
    "@babel/types": "^7.23.6"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
